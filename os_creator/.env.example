# ── Fracttal One — credenciais ────────────────────────────────────────────────
# A API usa OAuth2 client_credentials (mesmo método do dashboard). Copie os valores
# do .env do projeto "Projeto API PV" (FRACTTAL_CLIENT_ID / FRACTTAL_CLIENT_SECRET).
FRACTTAL_BASE_URL=https://app.fracttal.com
FRACTTAL_CLIENT_ID=
FRACTTAL_CLIENT_SECRET=

# Alternativa: um token Bearer já pronto (se preenchido, tem prioridade e ignora
# client_id/secret). Útil p/ teste rápido — mas expira (~1h), então prefira o OAuth.
# FRACTTAL_TOKEN=
