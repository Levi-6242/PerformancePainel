/* Chamados 1B — folha corrigida.
   Derivada de tokens.py. O que depende da cor do GRUPO (gradiente e borda do card)
   é aplicado por código com tokens.card_gradient(cor).

   MUDANÇA IMPORTANTE NA PRIMEIRA REGRA:
   a versão anterior abria com  QWidget { background: #07090F; }  — e como QLabel é
   um QWidget, TODO rótulo carimbava um retângulo opaco por cima de qualquer
   superfície tingida (header do detalhe, gradiente do card). O porte tinha que
   escrever background:transparent rótulo a rótulo. Agora a cor de fundo é
   aplicada só na raiz da página e QLabel é transparente por regra. */

/* `background: transparent` AQUI É OBRIGATÓRIO, não é redundância.
   O `main.py` aplica o DARK_QSS na APLICAÇÃO inteira, e ele abre com
   `QWidget { background:#090d18; }` — o navy do tema antigo. Todo invólucro de campo é um
   QWidget puro, então herdava esse fundo e aparecia uma FAIXA ESCURA atrás de cada rótulo,
   em toda tela nova (medido: (9,13,24) na faixa contra (16,21,35) do painel ao lado).
   Sem esta linha o problema volta sozinho a cada widget novo. */
QWidget { background: transparent; color: #E7EAF2; font-family: "Inter", "Segoe UI", sans-serif; }
QWidget#chPage, QDialog { background: #07090F; }
/* A ALOCAÇÃO VOLTOU AO NAVY PADRÃO (revisão 1B, 28/07/2026): o app passa a ter uma linguagem só.
   A propriedade tela="perf" continua marcada no código de propósito — se algum dia a tela
   precisar de fundo próprio, é esta regra que volta, e só ela. */
QLabel, QCheckBox, QRadioButton { background: transparent; }

QFrame#panel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #111624, stop:1 #0C111C);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
}
/* flat = a tela OCUPA a janela, em vez de flutuar como um cartão sobre um fundo mais escuro.
   Nos QUADROS (Alocação, Chamados) a moldura sobrava: o conteúdo já é feito de cards, e um card
   grande em volta de cards pequenos vira moldura dentro de moldura. Nos DIÁLOGOS ela fica. */
QFrame#panel[flat="true"] { background: transparent; border: none; border-radius: 0; }

/* ---------- cards ---------- */
/* group = cor da COLUNA (não do status). O status vive só no texto. */
/* 1B: o card tem TRILHO DE PRIORIDADE — border-left de 3px na cor, aplicado por código
   (a cor varia por card, e o Qt desenha borda grossa acompanhando o raio; um widget de 3px
   dentro do card não acompanharia o arredondamento). O gradiente do topo SAIU: com o trilho,
   o degradê era um segundo sinal para a mesma informação. */
QFrame#card { background: #121927; border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; }
QFrame#card:hover { border-color: rgba(255,255,255,0.28); }
QFrame#card[group="red"]        { border-color: rgba(228,99,91,0.22); }
QFrame#card[group="red"]:hover  { border-color: rgba(228,99,91,0.55); }
QFrame#card[group="amber"]      { border-color: rgba(216,154,63,0.22); }
QFrame#card[group="amber"]:hover{ border-color: rgba(216,154,63,0.55); }
QFrame#card[group="blue"]       { border-color: rgba(90,147,220,0.22); }
QFrame#card[group="blue"]:hover { border-color: rgba(90,147,220,0.55); }
QFrame#card[done="true"]        { background: #0E1320; border-color: rgba(255,255,255,0.07); }
QFrame#card[done="true"]:hover  { border-color: rgba(70,184,124,0.40); }

/* ---------- tipografia por papel ----------
   letter-spacing NÃO existe em QSS — o tracking sai por chamado_fontes.aplicar(). */
QLabel#osNumber      { font-family: "JetBrains Mono", Consolas, monospace;
                       font-size: 19px; font-weight: 700; color: #FFFFFF; }
QLabel#osNumberLarge { font-family: "JetBrains Mono", Consolas, monospace;
                       font-size: 24px; font-weight: 700; color: #FFFFFF; }
QLabel#panelTitle    { font-size: 20px; font-weight: 500; color: #F2F4FA; }
QLabel#cardTitle     { font-size: 13px; font-weight: 600; color: #E7EAF2; }
QLabel#secondary     { font-size: 11px; color: #7A85A0; }
QLabel#meta          { font-size: 10px; color: #5B6479; }
QLabel#sectionLabel  { font-size: 10px; font-weight: 600; color: #4E576D; }
QLabel#colHeader     { font-size: 11px; font-weight: 700; }
QLabel#counter       { font-family: "JetBrains Mono", Consolas, monospace;
                       font-size: 11px; font-weight: 700; color: #7A85A0; }
QLabel#date          { font-family: "JetBrains Mono", Consolas, monospace;
                       font-size: 12px; font-weight: 700; }
QLabel#body          { font-size: 12px; color: #D5DBE8; }
QLabel#empty         { font-size: 11px; color: #4E576D; }

QLabel#status[tone="red"]   { font-size: 11px; font-weight: 600; color: #EE968F; }
QLabel#status[tone="amber"] { font-size: 11px; font-weight: 600; color: #E6BE7E; }
QLabel#status[tone="blue"]  { font-size: 11px; font-weight: 600; color: #97BCEB; }
QLabel#status[tone="green"] { font-size: 11px; font-weight: 600; color: #82CFA4; }

/* 1B: a INICIAL da pessoa no cabeçalho da coluna. O fundo é rgba na cor do analista e vem
   INLINE do código (rgba vindo da folha não pinta com pai transparente); aqui ficam só a
   forma e o tipo. 20x20 com raio 10 = círculo, e 10 é inteiro. */
QLabel#inicial { font-size: 9px; font-weight: 700; border-radius: 10px; min-width: 20px;
                 max-width: 20px; min-height: 20px; max-height: 20px; }

/* chip de fabricante — pill de CONTORNO, nunca preenchido (README §3.2).
   raio = altura/2; a pill tem ~22px, daí 11. Raio FRACIONÁRIO é descartado pelo
   parser do Qt — nunca escreva 11.5px. */
QLabel#chip { font-size: 10px; font-weight: 600; color: #96A0B8;
              border: 1px solid rgba(255,255,255,0.12); border-radius: 11px; padding: 3px 9px; }

/* ---------- botões ---------- */
QPushButton {
    background: transparent; border: 1px solid rgba(255,255,255,0.14);
    color: #C6CDDC; border-radius: 9px; padding: 8px 14px; font-size: 12px;
}
QPushButton:hover   { border-color: rgba(163,207,60,0.50); color: #FFFFFF; }
QPushButton:pressed { background: rgba(255,255,255,0.04); }
QPushButton:focus   { border-color: #A3CF3C; }   /* Qt ignora outline */
QPushButton:disabled{ color: #4E576D; border-color: rgba(255,255,255,0.07); }

QPushButton#primary         { border: 1px solid rgba(163,207,60,0.50); color: #A3CF3C; font-weight: 600; }
QPushButton#primary:hover   { background: rgba(163,207,60,0.12); border-color: #A3CF3C; }
QPushButton#primary:pressed { background: rgba(163,207,60,0.18); }

/* pílula selecionável (fabricante em "Abrir chamado") — MESMA linguagem do chip do card:
   contorno puro, nunca preenchido. A largura é do CONTEÚDO, nunca fixa: a grade 5x2 de botões
   iguais comia duas fileiras de 70px e engessava a tela mais importante do fluxo. */
QPushButton#pill {
    background: transparent; border: 1px solid rgba(255,255,255,0.12);
    color: #96A0B8; border-radius: 13px; padding: 5px 13px; font-size: 12px;
}
QPushButton#pill:hover   { border-color: rgba(255,255,255,0.28); color: #E7EAF2; }
QPushButton#pill:checked { border-color: rgba(163,207,60,0.50); color: #A3CF3C; font-weight: 600; }

/* ---------- entradas ---------- */
/* QDateTimeEdit entra na MESMA regra: sem ele o campo de data saía mais fino que
   os vizinhos na tela "Abrir chamado", que é onde ele aparece. */
QComboBox, QLineEdit, QTextEdit, QDateTimeEdit {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12);
    border-radius: 9px; padding: 9px 12px; color: #E7EAF2; font-size: 12px;
}
QComboBox:hover, QLineEdit:hover, QTextEdit:hover, QDateTimeEdit:hover { border-color: rgba(163,207,60,0.45); }
QComboBox:focus, QLineEdit:focus, QTextEdit:focus, QDateTimeEdit:focus { border-color: #A3CF3C; }
QComboBox::drop-down, QDateTimeEdit::drop-down { border: none; width: 22px; }
/* o QDateTimeEdit herda de QAbstractSpinBox e reserva altura para as setinhas de incremento,
   saindo 4px mais alto que os vizinhos. Com calendarPopup ligado elas nem aparecem, mas o
   espaço continua reservado — daí o padding menor, para a caixa fechar na mesma altura. */
QDateTimeEdit::up-button, QDateTimeEdit::down-button { width: 0; height: 0; border: none; }
QDateTimeEdit { padding: 7px 12px; }
/* SETA É MARCA, E MARCA SE PINTA. O truque de bordas aqui NÃO funciona: o Qt trata a
   subcontrol como caixa com tamanho mínimo e desenha um retângulo cinza no lugar do
   triângulo. A subcontrol fica invisível e quem desenha o chevron é chamado_pecas.Combo. */
QComboBox::down-arrow { image: none; width: 0; height: 0; }
QComboBox QAbstractItemView {
    background: #121927; border: 1px solid rgba(255,255,255,0.12);
    selection-background-color: rgba(163,207,60,0.15); color: #E7EAF2; outline: none;
}

/* filtro do board: é CROMO, não conteúdo — discreto parado, aceso filtrando */
QComboBox#filtro { padding: 5px 10px; font-size: 11px; border-radius: 8px;
                   background: rgba(255,255,255,0.03); color: #A9B2C6; }
QComboBox#filtro:hover          { border-color: rgba(163,207,60,0.40); color: #E7EAF2; }
QComboBox#filtro[ativo="true"]  { border-color: rgba(163,207,60,0.30);
                                  background: rgba(163,207,60,0.10); color: #B9E05B; }

/* ---------- barra de rolagem ---------- */
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: rgba(255,255,255,0.09); border-radius: 4px; min-height: 40px; }
QScrollBar::handle:vertical:hover { background: rgba(255,255,255,0.20); }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

/* NÃO declare aqui: QFrame#divider / #railLine / #timeBar / QLabel#dot.
   São MARCAS — vivem em chamado_pecas.py, pintadas. Ver LEIA_PRIMEIRO.md §1. */
