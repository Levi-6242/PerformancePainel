# /etc/gridco/gemeo/servico.env — caminhos e fuso dos três serviços do gêmeo. NÃO tem segredo.
# Os segredos ficam em gemeo.env, na pasta apontada por SECRETS_DIR.
SECRETS_DIR=/etc/gridco/gemeo
GEMEO_CONFIG=/srv/PerformancePainel/gemeo/config.toml
# Banco do gêmeo (SQLite, ~2,2 GB). Obrigatório no Linux: o padrão do código é %LOCALAPPDATA%, que
# só existe no Windows. Nunca em pasta sincronizada.
GEMEO_DB_CAMINHO=/var/lib/gridco/gemeo/gemeo.sqlite
# Mesmo fuso da plataforma. Sem ele, "agora" é UTC e toda régua que compara hora de leitura erra 3 h
# (foi o incidente de 22/09/2026 na plataforma: 108 de 115 usinas "sem comunicação").
TZ=America/Sao_Paulo
PYTHONUNBUFFERED=1
