# /etc/gridco/gemeo/gemeo.env — SEGREDOS do gêmeo. chmod 600, dono = o usuário dos serviços.
# Nunca no git, nunca por e-mail/chat. Uma chave por linha, sem aspas.

# Token de API da SunOp (o de /data, validade ~1 ano) — o MESMO SUNOP_API_TOKEN do tokens.txt.
SUNOP_API_TOKEN=
# Token da Gridco Performance API — o mesmo do tokens.txt da plataforma.
GRIDCO_SQL_TOKEN=
# Senha compartilhada das telas do gêmeo. TEM de ser IGUAL à GEMEO_SENHA do tokens.txt: é com ela
# que a plataforma entra no gêmeo (proxy /gemeo/) e que o gêmeo lê os trackers de volta.
GEMEO_SENHA=
# Postgres da Thopen (usinas de fonte pg). O IP do servidor precisa estar liberado no banco.
POWERPLANTS_DSN=host=... port=5432 dbname=powerplants user=... password=...
# Conta oem@ da API PV (as três usinas da 2C) — a mesma do tokens.txt.
PV_OEM_USERNAME=
PV_OEM_PASSWORD=
# Endereço da plataforma NESTE servidor. O padrão é http://127.0.0.1:5050; só preencha se a
# plataforma escutar em outra porta.
# PLATAFORMA_URL=http://127.0.0.1:5050
# PV_PLAT_TOKEN_OEM: NÃO é mais necessário (desde 21/09/2026 os trackers da 2C vêm da plataforma).
