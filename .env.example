# Modelo de configuração — copie para `.env` e preencha com as credenciais reais.
# O `.env` real está no .gitignore e NUNCA deve ser commitado nem entrar no ZIP de entrega.
# Tudo é opcional: cada integração sem credencial apenas fica "indisponível" (o app sobe igual).

# ── App / sessão ─────────────────────────────────────────────────────────────
# Senha única do dashboard (gate de login). VAZIO = app aberto (sem login) — use só em dev.
DASH_PASSWORD=
# Chave de assinatura do cookie de sessão do Flask. Gere uma aleatória em produção.
SECRET_KEY=

# ── API PV Operation (Thopen) — apipv.pvoperation.com.br ─────────────────────
PV_USERNAME=
PV_PASSWORD=

# ── SunOp Athon (gridco) — JWT de sessão (~7 dias, auto-renova) ──────────────
# Semente; o token renovado é persistido em sunop_token.txt. Renovar manualmente:
# gridco.sunop.net → F12 → Console → localStorage.getItem('token')
# O token funcional tem claim sub NUMÉRICO + is_admin (tokens "sub:Levi" são rejeitados).
SUNOP_TOKEN=
# ── SunOp Axis (2ª instância: PE III, Ponto Belo) — JWT ~24h, auto-renova ────
# Semente; persistido em axis_token.txt. axis.sunop.net → F12 → localStorage 'token'
AXIS_TOKEN=
# Intervalo (s) do amostrador do acumulador ETM do SunOp (padrão 300 = 5 min)
# SUNOP_SAMPLE_INTERVAL=300

# ── PV Plataforma (Curva das strings / Trackers) — apiplataforma.pvoperation.com
# Token MANUAL (~7 dias). Vai no arquivo plat_token.txt OU nesta variável.
# Renovar: plataforma.pvoperation.com → F12 → header x-auth-token-update (ou bookmarklet).
PLAT_TOKEN=

# ── PostgreSQL powerplants (Thopen, AWS RDS) ─────────────────────────────────
PG_HOST=
PG_PORT=5432
PG_DB=powerplants
PG_USER=
PG_PASSWORD=

# ── SolarEdge (RenoGrid) — login AWS Cognito ─────────────────────────────────
# Alternativa às variáveis: arquivo se_credentials.txt (linha 1 = usuário, linha 2 = senha).
SE_USERNAME=
SE_PASSWORD=
# IDs do pool Cognito do SolarEdge (têm default no código; sobrescreva se mudarem).
# SE_COGNITO_CLIENT=
# SE_COGNITO_POOL=

# ── Fracttal (CMMS — criação/consulta de OS e Solicitações) ──────────────────
# OAuth2 client_credentials (LEITURA via REST). Base real: app.fracttal.com.
FRACTTAL_CLIENT_ID=
FRACTTAL_CLIENT_SECRET=
# FRACTTAL_BASE_URL=https://app.fracttal.com
# FRACTTAL_ID_COMPANY=4987
# FRACTTAL_ID_SERVER=AMERICAN
# FRACTTAL_COMPANY_DESC=GRID CO. LTDA
# Token OAuth já obtido (opcional; o app pega sozinho com CLIENT_ID/SECRET):
# FRACTTAL_TOKEN=
# JWT de sessão (login do usuário) p/ as rotas RPC de OS (opcional; o app desktop os_creator usa isto):
# FRACTTAL_LOGIN_JWT=

# ── Caminhos locais (override) ───────────────────────────────────────────────
# BD_Performance vem do OneDrive sincronizado; aponte aqui p/ uma cópia local se quiser:
# BD_PERF_PATH=C:\caminho\BD_Performance.xlsx
# BD_THOPEN_PATH=C:\caminho\BD_Thopen.xlsx
# Planilha de Tickets de Performance (cruzamento de trackers):
# TICKETS_PATH=C:\caminho\Tickets de Performance (atualizada).xlsx
# Raiz dos CSVs do coletor 2C/Gmail (Owen):
# OWEN_ROOT=C:\caminho\Projetos e-mail
