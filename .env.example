# Modelo de configuração — copie para `.env` e preencha com as credenciais reais.
# O `.env` real está no .gitignore e NUNCA deve ser commitado.

# ── API PV Operation (Thopen) ────────────────────────────────────────────────
# Credenciais de login da apipv.pvoperation.com.br
PV_USERNAME=
PV_PASSWORD=

# ── SunOp (Athon) — JWT de sessão (~7 dias) ─────────────────────────────────
# Renovar: gridco.sunop.net → F12 → Console → localStorage.getItem('token')
# Atenção: o token funcional tem claim sub numérico + is_admin (tokens "sub:Levi" são rejeitados).
SUNOP_TOKEN=

# ── PostgreSQL powerplants (Thopen) ──────────────────────────────────────────
PG_HOST=
PG_PORT=5432
PG_DB=powerplants
PG_USER=
PG_PASSWORD=

# ── SolarEdge (RenoGrid) — login Cognito ─────────────────────────────────────
# Alternativa: arquivo se_credentials.txt (linha 1 = usuário, linha 2 = senha)
SE_USERNAME=
SE_PASSWORD=

# ── PV Plataforma (Curva das strings) ────────────────────────────────────────
# O token vai no arquivo plat_token.txt (não em variável):
# portal plataforma.pvoperation.com → F12 → header x-auth-token-update

# ── 2C / E-mail (Owen) ───────────────────────────────────────────────────────
# Raiz dos CSVs baixados pelo coletor Gmail (padrão: Desktop\Projetos e-mail)
# OWEN_ROOT=
