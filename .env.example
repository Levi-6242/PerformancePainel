# Modelo de configuração — copie para `.env` e preencha com as credenciais reais.
# O `.env` real está no .gitignore e NUNCA deve ser commitado.

# ── API PV Operation (Thopen) ────────────────────────────────────────────────
# Credenciais de login da apipv.pvoperation.com.br
PV_USERNAME=
PV_PASSWORD=

# ── SunOp (Athon) — JWT de sessão (~7 dias) ─────────────────────────────────
# Renovar: gridco.sunop.net → F12 → Console → localStorage.getItem('token')
# Atenção: o token funcional tem claim sub numérico + is_admin (tokens "sub:Levi" são rejeitados).
SUNOP_TOKEN=

# ── PostgreSQL powerplants (Thopen) ──────────────────────────────────────────
PG_HOST=
PG_PORT=5432
PG_DB=powerplants
PG_USER=
PG_PASSWORD=

# ── SolarEdge (RenoGrid) — login Cognito ─────────────────────────────────────
# Alternativa: arquivo se_credentials.txt (linha 1 = usuário, linha 2 = senha)
SE_USERNAME=
SE_PASSWORD=

# ── PV Plataforma (Curva das strings) ────────────────────────────────────────
# O token vai no arquivo plat_token.txt (não em variável):
# portal plataforma.pvoperation.com → F12 → header x-auth-token-update

# ── 2C / E-mail (Owen) ───────────────────────────────────────────────────────
# Raiz dos CSVs baixados pelo coletor Gmail (padrão: Desktop\Projetos e-mail)
# OWEN_ROOT=

# ── BD_Performance via SharePoint (Microsoft Graph, Sites.Selected) ──────────
# Registro de app no Azure AD + permissão Sites.Selected concedida ao site do O&M.
# Passo a passo e texto do pedido pro TI: docs/sharepoint-graph.md
# Enquanto vazio, o BD_Performance continua vindo do OneDrive sincronizado/cópia local.
AZ_TENANT_ID=
AZ_CLIENT_ID=
AZ_CLIENT_SECRET=
# Host e caminho do site no SharePoint (ex.: gridco.sharepoint.com + /sites/OeM)
GRAPH_SITE_HOST=
GRAPH_SITE_PATH=
# Caminho do arquivo DENTRO da biblioteca de documentos do site, ex.:
# GRAPH_FILE_PATH=6.Gerencial/4. Gestão à vista/1. Banco de Dados/BD_Performance.xlsx
GRAPH_FILE_PATH=
# Intervalo do sync em segundos (padrão 300 = 5 min)
# GRAPH_SYNC_SECS=300
